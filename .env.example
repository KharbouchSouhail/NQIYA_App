# Copy to .env and fill in. Never commit the real .env.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
DB_PASSWORD=nqiya

# AI photo gate: "groq" (recommended), "gemini", or "stub" (offline, accepts every photo)
AI_PROVIDER=groq
# https://console.groq.com/keys
GROQ_API_KEY=
# comma-separated vision models, tried in order
GROQ_MODELS=qwen/qwen3.8-27b
GEMINI_API_KEY=

# SMTP for the 6-digit login codes. Leave empty to only log the codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=NQIYA <no-reply@nqiya.ma>

# Comma-separated emails that become admins on login
ADMIN_EMAILS=

# true = the login code is shown in the app (demo only, never in production)
AUTH_DEV_MODE=false
